<html lang='ar' dir='rtl'>
  <head>
    <meta charset='UTF-8' />
    <title>رسالة جديدة من نموذج تواصل معنا</title>
    <style>
      body {
        background-color: #f4f4f7;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        padding: 0;
        margin: 0;
        direction: rtl;
      }
      .container {
        max-width: 600px;
        margin: 40px auto;
        background: #ffffff;
        border-radius: 8px;
        box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.1);
        overflow: hidden;
      }
      .header {
        background-color: #4f46e5;
        color: #ffffff;
        text-align: center;
        padding: 20px 0;
        font-size: 24px;
        font-weight: bold;
      }
      .content {
        padding: 30px;
        text-align: right;
      }
      .content h2 {
        color: #333333;
        margin-bottom: 10px;
      }
      .content p {
        color: #555555;
        font-size: 16px;
        margin-bottom: 15px;
        line-height: 1.6;
      }
      .message-box {
        background-color: #f9fafb;
        border: 1px solid #eee;
        border-radius: 8px;
        padding: 15px;
        margin-top: 10px;
        white-space: pre-wrap;
        color: #333333;
      }
      .button {
        display: inline-block;
        background-color: #4f46e5;
        color: #ffffff;
        padding: 12px 25px;
        border-radius: 5px;
        text-decoration: none;
        font-size: 16px;
        margin-top: 25px;
      }
      .footer {
        margin-top: 20px;
        padding: 15px;
        text-align: center;
        font-size: 12px;
        color: #999999;
      }
    </style>
  </head>
  <body>
    <div class='container'>
      <div class='header'>رسالة جديدة من نموذج تواصل معنا</div>
      <div class='content'>
        <p>
          الاسم:
          <strong>{{name}}</strong><br />
          البريد الإلكتروني:
          <strong>{{email}}</strong><br />
          رقم الهاتف:
          <strong>{{phone}}</strong><br />
          نوع الاستفسار:
          <strong>{{inquiryTypeLabel}}</strong>
        </p>
        <p>نص الرسالة:</p>
        <div class='message-box'>{{message}}</div>

        <a href='mailto:{{email}}' class='button'>الرد على المرسل</a>
      </div>
      <div class='footer'>
        &copy;
        {{year}}
        {{companyName}}. جميع الحقوق محفوظة.
      </div>
    </div>
  </body>
</html>
