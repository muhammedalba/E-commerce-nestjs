<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <title>New quote request</title>
    <style>
      body {
        background-color: #f4f4f7;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        padding: 0;
        margin: 0;
      }
      .container {
        max-width: 600px;
        margin: 40px auto;
        background: #ffffff;
        border-radius: 8px;
        box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.1);
        overflow: hidden;
      }
      .header {
        background-color: #16a34a;
        color: #ffffff;
        text-align: center;
        padding: 20px 0;
        font-size: 24px;
        font-weight: bold;
      }
      .content {
        padding: 30px;
        text-align: left;
      }
      .content h3 {
        margin: 24px 0 8px;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #16a34a;
      }
      .content p {
        color: #555555;
        font-size: 15px;
        margin: 0 0 6px;
        line-height: 1.7;
      }
      .box {
        background-color: #f9fafb;
        border: 1px solid #eee;
        border-radius: 8px;
        padding: 15px;
        margin-top: 8px;
        white-space: pre-wrap;
        color: #333333;
      }
      .footer {
        margin-top: 20px;
        padding: 15px;
        text-align: center;
        font-size: 12px;
        color: #999999;
      }
    </style>
  </head>
  <body>
    <div class='container'>
      <div class='header'>New Quote Request ({{customerTypeLabel}})</div>
      <div class='content'>
        <h3>Customer Details</h3>
        <p>Name: <strong>{{name}}</strong></p>
        <p>Customer Type: <strong>{{customerTypeLabel}}</strong></p>
        <p>Phone: <strong>{{phone}}</strong></p>
        <p>Email: <strong>{{emails}}</strong></p>
        <p>Preferred Contact Method: <strong>{{preferredContactMethodLabel}}</strong></p>

        {{#if commercialRegistrationNumber}}
        <h3>Company Details</h3>
        <p>Commercial Registration No.: <strong>{{commercialRegistrationNumber}}</strong></p>
        <p>Tax Number: <strong>{{taxNumber}}</strong></p>
        <p>National Address: <strong>{{nationalAddress}}</strong></p>
        {{/if}}

        <h3>Order Details</h3>
        <div class='box'>{{orderDetails}}</div>

        <h3>Delivery Address</h3>
        <div class='box'>{{deliveryAddress}}</div>
      </div>
      <div class='footer'>
        &copy;
        {{year}}
        {{companyName}}. All rights reserved.
      </div>
    </div>
  </body>
</html>
