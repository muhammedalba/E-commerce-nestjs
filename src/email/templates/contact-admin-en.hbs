<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <title>New contact message received</title>
    <style>
      body {
        background-color: #f4f4f7;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        padding: 0;
        margin: 0;
      }
      .container {
        max-width: 600px;
        margin: 40px auto;
        background: #ffffff;
        border-radius: 8px;
        box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.1);
        overflow: hidden;
      }
      .header {
        background-color: #4f46e5;
        color: #ffffff;
        text-align: center;
        padding: 20px 0;
        font-size: 24px;
        font-weight: bold;
      }
      .content {
        padding: 30px;
        text-align: left;
      }
      .content h2 {
        color: #333333;
        margin-bottom: 10px;
      }
      .content p {
        color: #555555;
        font-size: 16px;
        margin-bottom: 15px;
        line-height: 1.6;
      }
      .message-box {
        background-color: #f9fafb;
        border: 1px solid #eee;
        border-radius: 8px;
        padding: 15px;
        margin-top: 10px;
        white-space: pre-wrap;
        color: #333333;
      }
      .button {
        display: inline-block;
        background-color: #4f46e5;
        color: #ffffff;
        padding: 12px 25px;
        border-radius: 5px;
        text-decoration: none;
        font-size: 16px;
        margin-top: 25px;
      }
      .footer {
        margin-top: 20px;
        padding: 15px;
        text-align: center;
        font-size: 12px;
        color: #999999;
      }
    </style>
  </head>
  <body>
    <div class='container'>
      <div class='header'>New Contact Message</div>
      <div class='content'>
        <p>
          Name:
          <strong>{{name}}</strong><br />
          Email:
          <strong>{{email}}</strong><br />
          Phone:
          <strong>{{phone}}</strong><br />
          Inquiry Type:
          <strong>{{inquiryTypeLabel}}</strong>
        </p>
        <p>Message:</p>
        <div class='message-box'>{{message}}</div>

        <a href='mailto:{{email}}' class='button'>Reply to sender</a>
      </div>
      <div class='footer'>
        &copy;
        {{year}}
        {{companyName}}. All rights reserved.
      </div>
    </div>
  </body>
</html>
