# ============================================================
# Environment Variables — Sky Galaxy NestJS Server
# ============================================================
# انسخ هذا الملف إلى .env وعدّل القيم حسب بيئتك.
# لا تضع قيمًا حساسة حقيقية في هذا الملف (يُرفع إلى GitHub).
# ============================================================

APP_NAME=Sky Galaxy
PORT=4000
BASE_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# ─── Auth ─────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=changeme
SUPER_ADMIN_NAME=Super Admin

# ─── OAuth ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ─── i18n ────────────────────────────────────────────────
DEFAULT_LANGUAGE=ar
LANGUAGES=ar,en

# ─── Security ────────────────────────────────────────────
SALTORROUNDS=10

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_EXPIRE_TIME=1d
JWT_REFRESH_TOKEN_EXPIRE_TIME=7

# ─── Database ────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/skygalaxy

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Mail ────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_ADDRESS=your_email@gmail.com
ADMIN_EMAIL=admin@yourdomain.com
SUPPORT_LINK=http://localhost:4000/support
LOGIN_LINK=http://localhost:4000/login
MAIL_RETRY_ATTEMPTS=3
MAIL_RETRY_DELAY=5000

# ─── CORS ────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
REVALIDATE_SECRET=change_this_secret

# ─── Images ──────────────────────────────────────────────
IMAGE_FORMAT=webp
IMAGE_QUALITY=80

# ═══════════════════════════════════════════════════════════
# UPLOADS STORAGE
# ═══════════════════════════════════════════════════════════
#
# UPLOADS_ROOT — المسار المطلق أو النسبي لمجلد تخزين الملفات.
#
#  مهم: هذا هو المتغير الوحيد الذي يحدد أين تُخزَّن الملفات.
#
#  Local Development:
#    يُستخدم المجلد النسبي (داخل مجلد المشروع):
UPLOADS_ROOT=./uploads
#
#  Production / Hostinger:
#    اضبط هذه القيمة في لوحة Hostinger → Environment Variables:
#    UPLOADS_ROOT=/home/YOUR_HOSTINGER_USERNAME/uploads
#
#  ملاحظة: لا تضع المسار الحقيقي لـ Hostinger هنا.
#  هذا الملف موجود في GitHub.
#
# ── المتغيرات المكملة (لا تغيّرها عادةً) ─────────────────
UPLOADS_FOLDER=uploads
UPLOADS_ROUTE=/uploads
# ═══════════════════════════════════════════════════════════

# ─── Payments ────────────────────────────────────────────
PAYMENT_CONFIG_SECRET=change_this_secret
LEGACY_IV_LENGTH=16
IV_LENGTH=12
MOYASAR_SECRET_KEY=sk_test_...
MOYASAR_WEBHOOK_SECRET=change_this_secret
