# ==============================================================================
# APPLICATION CORE SETTINGS
# ==============================================================================
APP_NAME="Sky Galaxy"
# Environment mode: 'development' or 'production'
NODE_ENV=development
PORT=4000
BASE_URL=http://localhost:4000

# ==============================================================================
# FRONTEND & CORS SETTINGS
# ==============================================================================
CLIENT_URL=https://e-commerce-nextjs-sodf.onrender.com
FRONTEND_ORIGIN=http://localhost:3000
REVALIDATE_SECRET=*****************
LOGIN_LINK=http://localhost:4000/login
SUPPORT_LINK=http://localhost:4000/support

# ==============================================================================
# DATABASE (MONGODB)
# ==============================================================================
# Use local URI for dev, and cluster URI for production
MONGODB_URI=mongodb://********

# ==============================================================================
# REDIS & QUEUE SETTINGS
# ==============================================================================
# Redis URL (e.g., Upstash or Aiven service)
REDIS_URL=rediss://default:***************************

# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================
# Password hashing
SALTORROUNDS=10

# JWT Configuration
JWT_SECRET_KEY=************************
JWT_EXPIRE_TIME=1d
# Enter numeric values only for refresh token (e.g., 7 means 7 days)
JWT_REFRESH_TOKEN_EXPIRE_TIME=7

# Initial Super Admin Credentials
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=codepropstec@gmail.com
SUPER_ADMIN_PASSWORD=111111

# ==============================================================================
# OAUTH PROVIDERS
# ==============================================================================
# Google OAuth
GOOGLE_CLIENT_ID=*****-*******************.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-*****************-6JsPOM

# Facebook OAuth
FACEBOOK_CLIENT_ID=************
FACEBOOK_CLIENT_SECRET=*******************

# ==============================================================================
# STORAGE & MEDIA UPLOADS
# ==============================================================================
# Local Storage Configuration
UPLOADS_FOLDER=uploads

# UPLOADS_ROOT - Permanent storage path for uploaded files
# - Local Dev (Default): ./uploads
# - Production (Hostinger): /home/YOUR_HOSTINGER_USERNAME/uploads 
# Note: Configure this via Hostinger Environment Variables in production
UPLOADS_ROOT=./uploads

# Cloudinary Base Configuration (Required)
CLOUDINARY_CLOUD_NAME=*****
CLOUDINARY_API_KEY=******
CLOUDINARY_API_SECRET=**********-5_Fic

# Cloudinary Additional Configuration (Optional)
CLOUDINARY_ROOT_FOLDER=skygalaxy
IMAGE_QUALITY=80
IMAGE_FORMAT=webp

# ==============================================================================
# MAIL & SMTP CONFIGURATION
# ==============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=****@gmail.com
MAIL_PASSWORD=******
MAIL_FROM_ADDRESS=****@gmail.com
ADMIN_EMAIL=skygalaxy.shop@gmail.com

# Mail Queue Retry Settings
MAIL_RETRY_ATTEMPTS=3
# Delay in milliseconds (5000 = 5 seconds)
MAIL_RETRY_DELAY=5000

# ==============================================================================
# PAYMENT & ENCRYPTION
# ==============================================================================
PAYMENT_CONFIG_SECRET=f*************
LEGACY_IV_LENGTH=16
IV_LENGTH=12

# Moyasar Gateway Configuration
MOYASAR_SECRET_KEY=*****************************
MOYASAR_WEBHOOK_SECRET=*********************

# ==============================================================================
# LOCALIZATION (i18n)
# ==============================================================================
DEFAULT_LANGUAGE=ar
LANGUAGES=ar,en