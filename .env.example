# ==============================================================================
# APPLICATION CORE SETTINGS
# ==============================================================================
APP_NAME="Sky Galaxy"
# Environment mode: 'development' or 'production'
NODE_ENV=development
PORT=4000
BASE_URL=http://localhost:4000

# ==============================================================================
# FRONTEND & CORS SETTINGS
# ==============================================================================
CLIENT_URL=https://e-commerce-nextjs-sodf.onrender.com
FRONTEND_ORIGIN=http://localhost:3000
REVALIDATE_SECRET=*****************
LOGIN_LINK=http://localhost:4000/login
SUPPORT_LINK=http://localhost:4000/support

# ==============================================================================
# DATABASE (MONGODB)
# ==============================================================================
# Use local URI for dev, and cluster URI for production
MONGODB_URI=mongodb://********
# Optional: database name inside that cluster/server (default: skyGalaxy).
# Point the app at a database restored from a backup by changing this.
MONGODB_DB_NAME=skyGalaxy

# ==============================================================================
# REDIS & QUEUE SETTINGS
# ==============================================================================
# Redis URL (e.g., Upstash or Aiven service)
REDIS_URL=rediss://default:***************************

# ==============================================================================
# RESPONSE CACHE SETTINGS (in-process memory cache)
# ==============================================================================
# Caches GET API responses in the server memory (per resource, language and
# user), plus role permissions. Entries are cleared automatically whenever the
# related data changes (@ClearCache), so these only control memory usage.
#
# CACHE_MAX_ITEMS: maximum number of cached entries. When the limit is
#   reached, the least recently used entry is evicted (LRU). This caps memory
#   usage: one entry is one API response (typically a few KB to ~100 KB).
#   Lower it on small servers (e.g. 500), raise it if RAM allows. Default: 1000.
CACHE_MAX_ITEMS=1000

# CACHE_CHECK_INTERVAL_MS: how often (in milliseconds) expired entries are
#   swept from memory. Without it, expired entries stay in RAM until read
#   again. 60000 = every minute. 0 disables the sweep (not recommended).
#   Default: 60000.
CACHE_CHECK_INTERVAL_MS=60000

# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================
# Password hashing
SALTORROUNDS=10

# JWT Configuration
# ES256 key pair, PEM on one line with literal \n. Generate with:
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt -out jwt-private.pem
#   openssl ec -in jwt-private.pem -pubout -out jwt-public.pem
# The PUBLIC key must also be set as JWT_PUBLIC_KEY on the Next.js server.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_EXPIRE_TIME=1d
# Enter numeric values only for refresh token (e.g., 7 means 7 days)
JWT_REFRESH_TOKEN_EXPIRE_TIME=7

# Server-to-server key (min 32 chars). The Next.js server sends it as x-internal-key
# so build/ISR/SSR fetches skip rate limiting. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Leave empty to disable the bypass. Set the same value as INTERNAL_API_KEY on the Next.js server.
INTERNAL_API_KEY=

# Optional. Proxies/CDNs in front of the API, used to find the real client IP
# (per-client rate limiting). Loopback (the local reverse proxy) is always trusted.
# Comma-separated presets (private, cloudflare), IPs or CIDR ranges:
#   TRUSTED_PROXIES=cloudflare
#   TRUSTED_PROXIES=151.101.0.0/16,2a04:4e40::/32   # any other CDN's published ranges
# Set the SAME value on the Next.js server. Invalid entries stop the API at startup.
# TRUSTED_PROXIES=

# Optional. Only for CDNs that send the client IP in their own header instead of
# X-Forwarded-For (e.g. true-client-ip). Honored only from trusted proxies.
# CLIENT_IP_HEADER=

# Initial Super Admin Credentials
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=codepropstec@gmail.com
SUPER_ADMIN_PASSWORD=111111

# ==============================================================================
# OAUTH PROVIDERS
# ==============================================================================
# Google OAuth
GOOGLE_CLIENT_ID=*****-*******************.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-*****************-6JsPOM
# Optional. Comma-separated client IDs of the mobile apps (iOS / Android).
# ID tokens sent to POST /auth/google/mobile must be issued for one of these
# or for GOOGLE_CLIENT_ID (Android apps that set it as serverClientId).
GOOGLE_MOBILE_CLIENT_IDS=

# Sign in with Apple (iOS app). Comma-separated bundle ids; identity tokens
# sent to POST /auth/apple/mobile must be issued for one of them.
APPLE_BUNDLE_IDS=shop.skygalaxy.app

# Facebook OAuth
FACEBOOK_CLIENT_ID=************
FACEBOOK_CLIENT_SECRET=*******************

# ==============================================================================
# STORAGE & MEDIA UPLOADS
# ==============================================================================
# Local Storage Configuration
UPLOADS_FOLDER=uploads

# UPLOADS_ROOT - Permanent storage path for uploaded files
# - Local Dev (Default): ./uploads
# - Production (Hostinger): /home/YOUR_HOSTINGER_USERNAME/uploads 
# Note: Configure this via Hostinger Environment Variables in production
UPLOADS_ROOT=./uploads

# Cloudinary Base Configuration (Required)
CLOUDINARY_CLOUD_NAME=*****
CLOUDINARY_API_KEY=******
CLOUDINARY_API_SECRET=**********-5_Fic

# Cloudinary Additional Configuration (Optional)
CLOUDINARY_ROOT_FOLDER=skygalaxy
IMAGE_QUALITY=80
IMAGE_FORMAT=webp

# ==============================================================================
# TAX INVOICE PDF (src/invoice/README.md)
# ==============================================================================
# typst-node (default): Typst's native binding, no browser, no child process.
# typst-cli: the typst executable, for a host where the binding cannot load.
# Check the host first: node scripts/invoice-smoke.mjs
INVOICE_PDF_RENDERER=typst-node
# typst-cli only: path to the typst executable (default: `typst` on PATH)
# TYPST_BIN=/home/YOUR_HOSTINGER_USERNAME/bin/typst

# ==============================================================================
# MAIL & SMTP CONFIGURATION
# ==============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=****@gmail.com
MAIL_PASSWORD=******
MAIL_FROM_ADDRESS=****@gmail.com
ADMIN_EMAIL=skygalaxy.shop@gmail.com

# Mail Queue Retry Settings
MAIL_RETRY_ATTEMPTS=3
# Delay in milliseconds (5000 = 5 seconds)
MAIL_RETRY_DELAY=5000

# ==============================================================================
# PAYMENT & ENCRYPTION
# ==============================================================================
PAYMENT_CONFIG_SECRET=f*************
LEGACY_IV_LENGTH=16
IV_LENGTH=12

# Moyasar Gateway Configuration
MOYASAR_SECRET_KEY=*****************************
MOYASAR_WEBHOOK_SECRET=*********************

# ==============================================================================
# LOCALIZATION (i18n)
# ==============================================================================
DEFAULT_LANGUAGE=ar
LANGUAGES=ar,en

# ==============================================================================
# GOOGLE reCAPTCHA v3 (contact + quote request forms)
# ==============================================================================
# Secret key from https://www.google.com/recaptcha/admin — never expose to the client
RECAPTCHA_SECRET_KEY=
# Minimum score to accept (0.0 = bot, 1.0 = human)
RECAPTCHA_MIN_SCORE=0.5
# Optional (production only): comma-separated hostnames tokens may come from.
# Defaults to the hostnames of CLIENT_URL and FRONTEND_ORIGIN.
RECAPTCHA_HOSTNAMES=

# ==============================================================================
# FIREBASE APP CHECK (mobile app — replaces reCAPTCHA on the same forms)
# ==============================================================================
# Firebase console > Project settings > General > Project number.
# Unset = App Check off (mobile requests fall back to the reCAPTCHA rules).
FIREBASE_PROJECT_NUMBER=
# Optional: comma-separated Firebase app ids (Project settings > Your apps),
# e.g. 1:123456789:android:abc,1:123456789:ios:def
FIREBASE_APP_IDS=

# ==============================================================================
# FIREBASE CLOUD MESSAGING (phone push notifications)
# ==============================================================================
# Firebase console > Project settings > Service accounts > Generate new private key.
# Paste the whole JSON file, or its base64 (base64 -w0 key.json). SECRET.
# Unset = push notifications off (the in-app notification list still works).
#[Convert]::ToBase64String([IO.File]::ReadAllBytes("C:\.json")) | Set-Clipboard
FIREBASE_SERVICE_ACCOUNT=

# ==============================================================================
# DATABASE BACKUPS → GOOGLE DRIVE (encrypted)  — see docs/BACKUP.md
# ==============================================================================
# Server master switch. Backups run only when this is true AND they are enabled
# in Admin > Settings > Database Backups. When true, every variable marked
# REQUIRED below is validated at startup.
BACKUP_ENABLED=false
# REQUIRED. Base64 of 32 random bytes: npm run backup:keygen. SECRET.
# Keep a copy outside this server and outside Google Drive (password manager):
# without it no backup can be restored.
BACKUP_ENCRYPTION_KEY=
# REQUIRED. Google Cloud > APIs & Services > Credentials > OAuth client (Desktop app).
GDRIVE_CLIENT_ID=
# REQUIRED. SECRET.
GDRIVE_CLIENT_SECRET=
# REQUIRED. From: npm run backup:auth (scope drive.file). SECRET.
GDRIVE_REFRESH_TOKEN=
# Optional: failure alerts (defaults to ADMIN_EMAIL).
BACKUP_ALERT_EMAIL=
# Optional: default retention in days until an admin saves one (7/14/30/60/90).
BACKUP_RETENTION_DAYS=14
# Optional: timezone used only if the store's business address gives none.
BACKUP_TIMEZONE=Asia/Riyadh
# Optional ops/dev override of the admin schedule (5-field cron). Leave empty in
# production — the admin panel schedule is the source of truth.
BACKUP_CRON=
# Optional: initial Drive folder name (admins can rename it later).
BACKUP_FOLDER_NAME=skygalaxy-db-backups
# Optional tuning: documents per cursor batch, read preference.
BACKUP_BATCH_SIZE=1000
BACKUP_READ_PREFERENCE=secondaryPreferred
# Optional: accept NON point-in-time backups if the cluster has no snapshot
# reads. Leave false unless docs/BACKUP.md "Consistency" says otherwise.
BACKUP_ALLOW_NON_SNAPSHOT=false
# Optional: hours after which the test-restore database (a full copy of the
# store's data) is dropped automatically. 0 = keep it until deleted by hand.
BACKUP_TEST_RESTORE_TTL_HOURS=24
# Optional: false on API instances when a separate instance (same code, same
# variables) is dedicated to running backups. At least one instance needs true.
BACKUP_WORKER_ENABLED=true
# Optional: older keys after a key rotation, comma-separated (restores and
# reading old uploads manifests).
BACKUP_DECRYPTION_KEYS=
# Optional: refuse a test restore (Admin > Backups) when the live database is
# larger than this many MB (default 200; empty = no limit). Atlas M0 = 512 MB total.
BACKUP_TEST_RESTORE_MAX_MB=200
# Optional: largest backup file/bundle that can be uploaded from the panel (MB).
# A reverse proxy in front of the API may need the same limit (client_max_body_size).
BACKUP_UPLOAD_MAX_MB=512
